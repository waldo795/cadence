# Copy to .env.local for local development, or set these on your host.
# Nothing here is needed to run locally — every value has a safe default or a
# development fallback.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Unset locally: the app runs PGlite (Postgres compiled to WASM) in data/pg.
# REQUIRED in production — the app refuses to start without it, because a local
# database on a host's filesystem is wiped on every deploy.
#
# Supabase: Project settings → Database → Connection string → URI
# DATABASE_URL="postgresql://user:password@host:5432/postgres"

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# The password for the whole app. Unset locally means no sign-in required;
# in production the app refuses to serve rather than run open.
# APP_PASSWORD="choose-something-long"

# Optional. Change it to sign everybody out without changing the password.
# SESSION_SECRET="a-long-random-string"

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# Bearer token for POST /api/cron. Unset locally means no token needed;
# in production the endpoint refuses to run without it.
#   curl -X POST https://your-app/api/cron -H "Authorization: Bearer $CRON_SECRET"
# CRON_SECRET="another-long-random-string"

# ---------------------------------------------------------------------------
# Website enquiry form
# ---------------------------------------------------------------------------
# Comma-separated origins allowed to POST /api/intake. Unset means any origin,
# which is right locally and wrong in production.
# INTAKE_ALLOWED_ORIGINS="https://makeupbyanniedaniel.co.uk,https://www.makeupbyanniedaniel.co.uk"

# ---------------------------------------------------------------------------
# Multi-tenancy
# ---------------------------------------------------------------------------
# Defaults to "default". Only needed if one deployment serves more than one
# business.
# CADENCE_TENANT_ID="default"

# ---------------------------------------------------------------------------
# Email delivery
# ---------------------------------------------------------------------------
# Unset means no email can be sent at all: journeys still decide and record
# what they would have sent, and every message is marked failed with the reason.
#
# Create the key at resend.com/api-keys with SENDING ACCESS only — Cadence
# never manages domains, keys or contacts, so a wider key only widens what a
# leak would cost. Scope it to your sending domain if the option is offered.
# RESEND_API_KEY="re_..."

# The sender. Must be on a domain verified in Resend.
#   Before a domain is verified, use Resend's sandbox sender:
#     EMAIL_FROM="Cadence <onboarding@resend.dev>"
#   which only delivers to the address that owns the Resend account — enough
#   for test mode, not enough to go live.
# EMAIL_FROM="Annie Daniel <hello@makeupbyanniedaniel.co.uk>"

# Optional. Where replies go, if not the sender.
# EMAIL_REPLY_TO="hello@makeupbyanniedaniel.co.uk"
